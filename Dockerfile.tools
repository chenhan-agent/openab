# syntax=docker/dockerfile:1
ARG BASE_IMAGE=ghcr.io/openabdev/openab:0.10.0-beta.5-copilot
ARG AGY_IMAGE=ghcr.io/openabdev/openab:0.10.0-beta.5-antigravity

# ==============================================================================
# Helper Stage: agy-source
# Extract official pre-compiled agy-acp adapter
# ==============================================================================
FROM ${AGY_IMAGE} AS agy-source

# ==============================================================================
# Stage 1: minimal
# Base: Official OpenAB Copilot image (ghcr.io/openabdev/openab:<version>-copilot)
# Pre-installed: openab, node 22, @github/copilot, gh CLI, user 'node'
# Adds:
#   - agy CLI (v1.4.9) & agy-acp adapter
#   - copilot-cli symlink
#   - Claude Code & ACP adapter
#   - Codex & ACP adapter
#   - Core productivity CLI tools & UTF-8 locales
#   - Chromium Playwright runtime
#   - Python venv with yt-dlp & requests
# ==============================================================================
FROM ${BASE_IMAGE} AS minimal

USER root

# 1. System utilities and productivity tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    aria2 \
    atomicparsley \
    bat \
    curl \
    direnv \
    dnsutils \
    fd-find \
    fzf \
    htop \
    iputils-ping \
    jq \
    less \
    locales \
    moreutils \
    ncdu \
    net-tools \
    openssh-client \
    poppler-utils \
    psmisc \
    python3 \
    python3-brotli \
    python3-pip \
    python3-virtualenv \
    rsync \
    screen \
    silversearcher-ag \
    sqlite3 \
    tig \
    tmux \
    tree \
    vim \
    wget \
    zip \
    unzip \
    zsh \
    && ln -s /usr/bin/batcat /usr/local/bin/bat \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && ln -s /home/node /home/agent \
    && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# 2. All AI Agents (Copilot, Antigravity, Claude Code, Codex)
# Copilot CLI symlink
RUN ln -s /usr/local/bin/copilot /usr/local/bin/copilot-cli

# Antigravity CLI (pinned 1.4.9) & ACP adapter
ARG AGY_VERSION=1.4.9
ENV AGY_VERSION=${AGY_VERSION}
ARG AGY_SHA256_AMD64=3d84e3a461b9cbf9ffc9deede155a01921380e964f51a82c0bc505db80ae8525
ARG AGY_SHA256_ARM64=0e75190d5aa48b0f7623b201cfef542cd36a1279b3d28afa7fa099983a073493
RUN ARCH=$(dpkg --print-architecture) && \
    case "$ARCH" in \
      amd64) ASSET="agy_cli_linux_x64.tar.gz"; sha="${AGY_SHA256_AMD64}" ;; \
      arm64) ASSET="agy_cli_linux_arm64.tar.gz"; sha="${AGY_SHA256_ARM64}" ;; \
      *) echo "unsupported arch: $ARCH" && exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/google-antigravity/antigravity-cli/releases/download/${AGY_VERSION}/${ASSET}" \
      -o /tmp/agy.tar.gz && \
    echo "${sha}  /tmp/agy.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/agy.tar.gz -C /usr/local/bin && \
    rm /tmp/agy.tar.gz && \
    mv /usr/local/bin/antigravity /usr/local/bin/agy && \
    ln -s /usr/local/bin/agy /usr/local/bin/antigravity && \
    chmod +x /usr/local/bin/agy
COPY --from=agy-source /usr/local/bin/agy-acp /usr/local/bin/agy-acp

# Claude Code & ACP adapter
ARG CLAUDE_AGENT_ACP_VERSION=0.59.0
ARG CLAUDE_CODE_VERSION=2.1.212
RUN npm install -g @agentclientprotocol/claude-agent-acp@${CLAUDE_AGENT_ACP_VERSION} @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} --retry 3
ENV CLAUDE_CODE_EXECUTABLE=/usr/local/bin/claude

# Codex & ACP adapter
ARG CODEX_ACP_VERSION=1.1.4
ARG CODEX_VERSION=0.144.1
RUN npm install -g @agentclientprotocol/codex-acp@${CODEX_ACP_VERSION} @openai/codex@${CODEX_VERSION} --fetch-retries=3

# 3. Playwright and Chromium runtime
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npm install -g playwright playwright-extra puppeteer-extra-plugin-stealth --retry 3 && \
    npx playwright install-deps chromium && \
    npx playwright install chromium && \
    chown -R node:node /ms-playwright

# 4. Isolated Python virtual environment for CLI tools
RUN python3 -m virtualenv /opt/venv && \
    chown -R node:node /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip3 install --no-cache-dir requests yt-dlp && \
    chown -R node:node /opt/venv

# 5. Agent directories
RUN mkdir -p /home/node/.copilot /home/node/.claude /home/node/.codex /home/node/.gemini && \
    chown -R node:node /home/node

USER node

# ==============================================================================
# Stage 2: full
# Inherits minimal (all agents, CLI tools, Chromium, Python venv)
# Adds:
#   - Global Rust toolchain (cargo, rustc, rustup) & build-essential
#   - sudo privileges for 'node' user
#   - Playwright Firefox runtime
#   - Virtual display & VNC debugging (xvfb, x11vnc, fluxbox, xterm)
#   - Advanced Python AI / web-scraping / conversion libraries
# ==============================================================================
FROM minimal AS full

USER root

# Build tools, media libraries, GUI/VNC debugging, and dev tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    fluxbox \
    ipython3 \
    keychain \
    python3-pudb \
    sudo \
    x11vnc \
    xterm \
    xvfb \
    && echo "node ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/node \
    && chmod 0440 /etc/sudoers.d/node \
    && rm -rf /var/lib/apt/lists/*

# Global Rust toolchain (for OpenAB and Rust development)
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:/opt/venv/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path && \
    chmod -R a+rwX /usr/local/cargo /usr/local/rustup

# Playwright Firefox runtime
RUN npx playwright install-deps firefox && \
    npx playwright install firefox && \
    chown -R node:node /ms-playwright

# Advanced Python crawling and AI conversion libraries
RUN pip3 install --no-cache-dir \
    beautifulsoup4 \
    crawl4ai \
    browser-use \
    trafilatura \
    firecrawl-py \
    shot-scraper \
    "markitdown[all]" && \
    chown -R node:node /opt/venv

USER node
